{
  "appId": "com.helpme4u",
  "appName": "HelpMe4U",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "server": {
    "url": "https://central.helpme4u.com",
    "allowNavigation": [
      "central.helpme4u.com",
      "helpme4u.com",
      "*.helpme4u.com"
    ],
    "errorPath": "error.html"
  }
}
